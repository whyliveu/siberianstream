{
  "name": "siberianstream",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/telegram/*"]
  },
  "vars": {
    "BOT_USERNAME": "mashkasad_streambot",
    "SITE_URL": "https://mashkasad.online/",
    "STATUS_URL": "https://mashkasad.online/status.json",
    "WEBHOOK_URL": "https://siberianstream.7marias5.workers.dev/api/telegram/webhook"
  },
  "durable_objects": {
    "bindings": [{"name":"STREAM_BOT","class_name":"StreamBot"}]
  },
  "migrations": [{"tag":"telegram-v1","new_sqlite_classes":["StreamBot"]}],
  "triggers": {"crons":["* * * * *"]}
}
